PORT=5000
# Prefer a complete URI. URL-encode username/password when building one manually.
MONGO_URI=mongodb://127.0.0.1:27017/clearpath
# Alternative component-based configuration (used when MONGO_URI is absent):
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_HOST=127.0.0.1:27017
# DB_NAME=clearpath
# MONGO_AUTH_SOURCE=admin
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_secure_password
